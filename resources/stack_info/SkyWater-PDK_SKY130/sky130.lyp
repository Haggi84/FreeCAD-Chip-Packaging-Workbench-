<?xml version="1.0" encoding="utf-8"?>
<!--
  KLayout layer properties for the SkyWater SKY130 (sky130A) open PDK,
  curated for chip-packaging work in the DI-PASSIONATE workbench.

  This is a SUBSET, not a copy of the full sky130A.lyp: it carries the
  layers that matter for packaging — the routing metals, the vias between
  them, the pad opening and the cell boundary — because those are what a
  package model, a bond-pad search and a die outline are built from. The
  implant and pin/label layers are listed for reference with
  visible=false, which is what keeps them out of the imported geometry.

  Layer/datatype numbers are the published sky130A values. Colours are
  chosen for legibility in this workbench and are NOT the official
  SkyWater display colours.

  To use the official file instead, point the profile's LYP path at the
  sky130A.lyp from your own PDK install (Technology Configuration ->
  Edit Profile). The parser understands KLayout's '68/20@1' source syntax.
-->
<layer-properties>
  <properties>
    <frame-color>#268bd2</frame-color>
    <fill-color>#268bd2</fill-color>
    <frame-brightness>0</frame-brightness>
    <fill-brightness>0</fill-brightness>
    <dither-pattern>I1</dither-pattern>
    <line-style/>
    <valid>true</valid>
    <visible>true</visible>
    <transparent>false</transparent>
    <width>1</width>
    <marked>false</marked>
    <xfill>false</xfill>
    <animation>0</animation>
    <name>nwell.drawing</name>
    <source>64/20@1</source>
  </properties>
